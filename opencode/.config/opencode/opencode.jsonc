{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-ntfy.sh"],
  "provider": {
    "llama-cpp": {
      "name": "llama-cpp on gpucluster",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://10.194.33.12:1337/v1"
      },
      "models": {
        "unsloth/gpt-oss-120b-GGUF:UD-Q8_K_XL": {
          "name": "GPT-OSS 120B"
        },
        "unsloth/Qwen3.8-27B-GGUF:UD-Q8_K_XL": {
          "name": "Qwen-3.8-27B"
        }
      },
      "compaction": {
        "auto": true,
        "prune": true,
        "reserved": 40000
      }
    },
    "llama-swap": {
      "name": "llama-swap on hilliard",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://10.194.12.113:1776/v1"
      },
      "models": {
        "gemma-4-26B-A4B": {
          "name": "Gemma-4 26B A4B"
        },
        "gpt-oss-20B": {
          "name": "GPT OSS 20B"
        }
      }
    }
  }
}
