send_kipps() {
  # --- Preset Configurations ---
  local dest_host1="hilliard"
  local preset1_base="GitHub/kipps/output"

  local dest_host2="nautilus"
  local preset2_base="papyrus/TheGrind"

  # Defaults
  local target_host="$dest_host1"
  local target_base="$preset1_base"
  local rename=""
  local sources=()

  # --- Parse Arguments ---
  while (( "$#" )); do
    case "$1" in
      --rename)
        if [[ -n "$2" && "$2" != -* ]]; then
          rename="$2"
          shift
        else
          echo "Error: --rename requires a non-empty argument" >&2
          return 1
        fi
        ;;
      -t|--target)
        if [[ -n "$2" && "$2" != -* ]]; then
          case "$2" in
            1|hilliard)
              target_host="$dest_host1"
              target_base="$preset1_base"
              ;;
            2|nautilus)
              target_host="$dest_host2"
              target_base="$preset2_base"
              ;;
            *)
              echo "Error: Unknown target preset '$2'" >&2
              return 1
              ;;
          esac
          shift
        else
          echo "Error: -t/--target requires a preset name or number" >&2
          return 1
        fi
        ;;
      -h|--help)
        echo "Usage: send_kipps <src...> [--rename sub/dir] [-t 1|2|hilliard|nautilus]"
        return 0
        ;;
      *)
        sources+=("$1")
        ;;
    esac
    shift
  done

  # --- Validation ---
  if (( ${#sources[@]} == 0 )); then
    echo "Usage: send_kipps <src...> [--rename sub/dir] [-t 1|2|hilliard|nautilus]" >&2
    return 1
  fi

  # Determine full remote destination
  local remote_dir="$target_base"
  if [[ -n "$rename" ]]; then
    rename="${rename%/}"
    remote_dir="$target_base/$rename"
  fi

  # --- Remote Directory Handling ---
  # If a custom subpath is specified and already exists, prompt before wiping it.
  if [[ -n "$rename" ]] && ssh "$target_host" "[ -e '$remote_dir' ]"; then
    printf "Remote directory '%s' already exists. Overwrite? [y/N]: " "$remote_dir" >&2
    read -r reply
    case "$reply" in
      y|Y|yes|YES)
        ssh "$target_host" "rm -rf -- '$remote_dir' && mkdir -p -- '$remote_dir'" || return 1
        ;;
      *)
        echo "Aborted." >&2
        return 1
        ;;
    esac
  else
    # Automatically ensures all nested parent folders (like dirB/) are created
    ssh "$target_host" "mkdir -p -- '$remote_dir'" || return 1
  fi

  # --- Sync ---
  rsync -avzP "${sources[@]}" "$target_host:$remote_dir/"
}
